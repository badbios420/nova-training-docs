  "tasks": [
    {
      "id": "T01",
      "name": "Vista license closed",
      "category": "ops_status",
      "severity": "high",
      "prompt": "Is a City of Vista business license required for the Millegar/home address? What is the current status?",
      "passThreshold": 0.5,
      "notes": "Pass if either WORLD_STATE or MEMORY strongly marks NOT REQUIRED / CLOSED / unincorporated; both weighted equally.",
      "graders": [
        {
          "type": "regex_in_file",
          "weight": 1,
          "params": {
            "file": "WORLD_STATE.md",
            "pattern": "Vista.*license[\\s\\S]{0,80}(CLOSED|NOT REQUIRED)|unincorporated[\\s\\S]{0,60}Vista|Local business license \\(Vista city\\).*CLOSED",
            "flags": "im"
          }
        },
        {
          "type": "regex_in_file",
          "weight": 1,
          "params": {
            "file": "MEMORY.md",
            "pattern": "Vista.*license[\\s\\S]{0,120}(NOT REQUIRED|CLOSED|unincorporated)|unincorporated SD County",
            "flags": "im"
          }
        }
      ]
    },
    {
      "id": "T02",
      "name": "FBN clear",
      "category": "ops_status",
      "severity": "high",
      "prompt": "What is the Big House FBN / newspaper publish status? Is Jason still blocked on publishing?",
      "passThreshold": 1.0,
      "notes": "Must show published/clear/CLOSED — not still-need-to-publish.",
      "graders": [
        {
          "type": "composite",
          "weight": 1,
          "params": {
            "mode": "all",
            "graders": [
              {
                "type": "world_state_fire",
                "weight": 1,
                "params": {
                  "file": "WORLD_STATE.md",
                  "pattern": "FBN[\\s\\S]{0,120}(CLOSED\\s*/\\s*CLEAR|Complete\\s*/\\s*clear|Published)",
                  "flags": "im"
                }
              },
              {
                "type": "file_not_contains",
                "weight": 1,
                "params": {
                  "file": "WORLD_STATE.md",
                  "needles": ["still need to publish"],
                  "caseInsensitive": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "T03",
      "name": "Hilltop weekly cut path",
      "category": "ops_status",
      "severity": "high",
      "prompt": "What is the current price path for 1434 Hilltop until it sells?",
      "passThreshold": 1.0,
      "notes": "1434 Hilltop + $5k/week (or −$5k/week) until sells in WORLD_STATE.",
      "graders": [
        {
          "type": "composite",
          "weight": 1,
          "params": {
            "mode": "all",
            "graders": [
              {
                "type": "file_contains",
                "weight": 1,
                "params": {
                  "file": "WORLD_STATE.md",
                  "needles": ["1434 Hilltop"],
                  "caseInsensitive": true
                }
              },
              {
                "type": "regex_in_file",
                "weight": 1,
                "params": {
                  "file": "WORLD_STATE.md",
                  "pattern": "\\$?5k\\s*/\\s*week|−\\$5k/week|\\$5k/week until",
                  "flags": "im"
                }
              }
            ]
          }
        }
      ]
    },
